{% extends "dashboard/dashboard.html.twig" %}

{% block content %}
	<div class="dashboard_content">
		<header>
			<h1>Edit {{ adulterant.name }}</h1>
		</header>
		<div class="add_edit_form dashboard_content_main_box">
			<p>Make changes to {{ adulterant.name }}.</p>
			{{ form(form) }}
			{% if is_granted('ROLE_ADMIN') %}
				<div class="delete_actions">
					<a href="{{ path('delete_adulterant', {uuid:uuid_encode(adulterant.uuid)}) }}" class="button danger">Delete Adulterant</a>
				</div>
			{% endif %}
		</div>
	</div>
{% endblock %}