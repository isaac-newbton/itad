{% extends "dashboard/dashboard.html.twig" %}

{% block content %}
	<div class="dashboard_content">
		<header>
			<h1>{{ adulterant.name }}</h1>
		</header>
		<div class="adulterant_details_container dashboard_content_main_box">
			<div class="adulterant_details">
				<div class="adulterant_image_container">
					{% if adulterant.thumbnail %}
						<img src="{{ adulterant.thumbnailImgSrc }}" alt="{{ adulterant.name }}">
					{% else %}
						{% if is_granted('ROLE_ADMIN') %}
							<a href="{{ path('add_adulterant_thumbnail', {uuid:uuid_encode(adulterant.uuid)}) }}" class="button">+Image</a>
						{% endif %}
					{% endif %}
				</div>
				<div class="adulterant_properties_container">
					{% if adulterant.synonyms|trim is not empty %}
						<div class="adulterant_property">
							<h2>Synonyms</h2>
							{{ adulterant.synonyms }}
						</div>
					{% endif %}
					{% if adulterant.spanishName|trim is not empty %}
						<div class="adulterant_property">
							<h2>Spanish</h2>
							{{ adulterant.spanishName }}
						</div>
					{% endif %}
					{% if adulterant.drugClass|trim is not empty %}
						<div class="adulterant_property">
							<h2>Drug Class</h2>
							{{ adulterant.drugClass }}
						</div>
					{% endif %}
					{% if adulterant.occurrenceUsage|trim is not empty %}
						<div class="adulterant_property">
							<h2>Occurrence/Usage</h2>
							{{ adulterant.occurrenceUsage|raw }}
						</div>
					{% endif %}
					{% if adulterant.physiologicalEffect|trim is not empty %}
						<div class="adulterant_property">
							<h2>Physiological Effect</h2>
							{{ adulterant.physiologicalEffect|raw }}
						</div>
					{% endif %}
					{% if adulterant.customFields is not empty %}
						{% for field in adulterant.customFields %}
							<div class="adulterant_property">
								<h2>{{ field.name }}</h2>
								{% if field.content|trim is not empty %}
									{{ field.content }}
								{% else %}
									N/A
								{% endif %}
								{% if is_granted('ROLE_ADMIN') %}
									<p class="meta">
										This is a custom field added by an admin. <a href="{{ path('edit_adulterant_field', {uuid:uuid_encode(field.uuid)}) }}">Click here to edit or delete {{ field.name }}.</a>
									</p>
								{% endif %}
							</div>
						{% endfor %}
					{% endif %}
				</div>
				{% if is_granted('ROLE_ADMIN') %}
					<a href="{{ path('add_adulterant_field', {uuid:uuid_encode(adulterant.uuid)}) }}" class="button">Add custom field</a>
				{% endif %}
			</div>
			<p><a href="{{ path('adulterants', {letter:adulterant.name|first|capitalize}) }}">Back to list</a></p>
			{% if is_granted('ROLE_ADMIN') %}
				<div class="delete_actions">
					<a href="{{ path('delete_adulterant', {uuid: uuid_encode(adulterant.uuid)}) }}" class="button danger">Delete {{ adulterant.name }}</a>
				</div>
			{% endif %}
		</div>
	</div>
{% endblock %}