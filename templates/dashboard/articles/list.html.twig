{% extends "dashboard/dashboard.html.twig" %}

{% block content %}
	<div class="dashboard_content">
		<header>
			<h1>Articles</h1>
		</header>
		<div class="articles_list">
			{% if articles is not empty %}
				{% for article in articles %}
					<div class="article_container">
						<article>
							<header>
								<span class="meta">{{ article.dt|date('m/d/Y') }}</span>
								<h2>{{ article.name }}</h2>
							</header>
							<div class="excerpt">
								{{ article.excerpt }}
							</div>
							<div class="read_more_container">
								<a href="{{ path('article', {uuid:uuid_encode(article.uuid)}) }}" class="button read_more">Read More</a>
							</div>
						</article>
					</div>
				{% endfor %}
			{% else %}
				<p>No articles are posted yet.</p>
			{% endif %}
			{% if is_granted('ROLE_ADMIN') %}
				<p><a href="{{ path('add_article') }}" class="button">Add Article</a></p>
			{% endif %}
		</div>
	</div>
{% endblock %}