{% extends "dashboard/dashboard.html.twig" %}

{% block content %}
	<div class="dashboard_content">
		<header>
			<h1>Articles</h1>
		</header>
		<div class="articles_list">
			{% if articles is not empty %}
				<div class="pagination_container">
					{{ knp_pagination_render(articles) }}
				</div>
				{% for article in articles %}
					<div class="article_container">
						<article>
							<header>
								<h2>{{ article.name }}</h2>
							</header>
							<div class="excerpt">
								{{ article.excerpt }}
							</div>
							<div class="read_more_container">
								<a href="{{ article.externalUrl ?? path('article', {uuid:uuid_encode(article.uuid)}) }}" class="button read_more" target="{{ article.externalUrl ? '_blank' : '_self' }}">Read More</a>
								{% if is_granted('ROLE_ADMIN') %}
									<a href="{{ path('edit_article', {uuid:uuid_encode(article.uuid)}) }}" class="button">Edit</a></p>
								{% endif %}
							</div>
						</article>
					</div>
				{% endfor %}
				<div class="pagination_container">
					{{ knp_pagination_render(articles) }}
				</div>
			{% else %}
				<p>No articles are posted yet.</p>
			{% endif %}
			{% if is_granted('ROLE_ADMIN') %}
				<p><a href="{{ path('add_article') }}" class="button">Add Article</a></p>
			{% endif %}
		</div>
	</div>
{% endblock %}