{% extends "dashboard/dashboard.html.twig" %}

{% block content %}
	<div class="dashboard_content">
		<div class="article">
			<header>
				<h1>{{ article.name }}</h1>
				<span class="meta">{{ article.dt|date('m/d/Y g:iA') }}</span>
			</header>
			<article>
				{{ article.content|raw }}
			</article>
			<footer>
				<p><a href="{{ path('articles') }}">Back to articles</a></p>
				{% if is_granted('ROLE_ADMIN') %}
					<div class="delete_actions">
						<a href="{{ path('delete_article', {uuid:uuid_encode(article.uuid)}) }}" class="button danger">Delete Article</a>
					</div>
				{% endif %}
			</footer>
		</div>
	</div>
{% endblock %}