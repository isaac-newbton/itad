{% extends "dashboard/dashboard.html.twig" %}

{% block content %}
	<div class="dashboard_content">
		<header>
			<h1>Countries</h1>
		</header>
		<div class="countries_list dashboard_content_main_box">
			{% if countries is not empty %}
				<ul>
					{% for country in countries %}
						<li><a href="{{ path('country', {code:country.code}) }}" title="{{ country.name }}">{{ country.name }}</a></li>
					{% endfor %}
				</ul>
			{% else %}
				<p>No countries are available at this time.</p>
			{% endif %}
			{% if is_granted('ROLE_ADMIN') %}
				<a href="{{ path('add_country') }}" class="button">Add Country</a>
			{% endif %}
		</div>
	</div>
{% endblock %}