{% extends "base.html.twig" %}

{% block body %}
	{% set currentPath = app.request.pathinfo %}
	{% set currentRoute = app.request.get('_route') %}
	<div class="dashboard" id="dashboard">
		<div class="dashboard_top_bar" id="dashboard_top_bar">
			top bar
		</div>
		<div class="dashboard_body" id="dashboard_body">
			<aside class="dashboard_sidebar" id="dashboard_sidebar">
				<nav class="dashboard_sidebar_nav">
					<header>
						<h1>Menu</h1>
					</header>
					<ul>
						<li class="{{ currentRoute in ['dashboard', 'countries', 'country', 'add_country'] ? 'active' : '' }}">
							<a href="{{ path('dashboard') }}">Countries</a>
						</li>
						<li class="{{ currentRoute in ['adulterants'] ? 'active' : '' }}">
							<a href="{{ path('adulterants') }}">Adulterant Definitions and Thesarus</a>
						</li>
						<li class="{{ currentRoute in ['resources', 'resources_articles', 'resources_publications', 'resources_presentations', 'view_article'] ? 'active' : '' }}">
							<a href="{{ path('resources') }}">Resources</a>
						</li>
					</ul>
				</nav>
			</aside>
			<main class="dashboard_main" id="dashboard_main">
				{% block content %}content{% endblock %}
			</main>
		</div>
	</div>
{% endblock %}