{% extends "base.html.twig" %}

{% set allCountries = all_countries() %}

{% block body %}
	{% set currentPath = app.request.pathinfo %}
	{% set currentRoute = app.request.get('_route') %}
	<div class="dashboard" id="dashboard">
		<div class="dashboard_top_bar" id="dashboard_top_bar">
			<div id="search_container">
				{% if app.user %}
					<div id="logout_container">
						<a href="{{ path('logout') }}" class="button">Log out</a>
					</div>
				{% endif %}
				<div id="search_country_container">
					<select id="select_country">
						<option value="" selected>Select a Country</option>
						{% if 0 < allCountries|length %}
							{% for country in allCountries %}
								<option value="{{ country.code }}">{{ country.name }}</option>
							{% endfor %}
						{% endif %}
					</select>
				</div>
				<div id="search_text_container">
					<form action="{{ path('search') }}" method="POST">
						<label for="top_bar_text_search">Search</label>
						<input type="text" name="term" id="top_bar_text_search" value="{{ searchTerm ?? '' }}" required>
						<button type="submit">Go</button>
					</form>
				</div>
			</div>
		</div>
		<div class="dashboard_body" id="dashboard_body">
			<aside class="dashboard_sidebar" id="dashboard_sidebar">
				<nav class="dashboard_sidebar_nav">
					<header>
						<h1>Menu</h1>
					</header>
					<ul>
						<li class="{{ currentRoute in ['dashboard', 'countries', 'country', 'add_country', 'report', 'add_report', 'add_flag'] ? 'active' : '' }}">
							<a href="{{ path('countries') }}">Countries</a>
						</li>
						<li class="{{ currentRoute in ['adulterants', 'adulterant', 'add_adulterant'] ? 'active' : '' }}">
							<a href="{{ path('adulterants') }}">Adulterant Definitions and Thesarus</a>
						</li>
						<li class="{{ currentRoute in ['resources', 'articles', 'publications', 'presentations', 'article', 'add_article', 'add_publication', 'add_presentation'] ? 'active' : '' }}">
							<a href="{{ path('resources') }}">Resources</a>
						</li>
					</ul>
				</nav>
			</aside>
			<main class="dashboard_main" id="dashboard_main">
				{% block content %}content{% endblock %}
			</main>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	<script>
		let countrySelect = document.getElementById('select_country')
		if(countrySelect){
			countrySelect.addEventListener('change', function(){
				let code = countrySelect.options[countrySelect.selectedIndex].value
				if(0<code.length){
					window.location.href = `/country/${code}`
				}
			})
		}
	</script>
{% endblock %}