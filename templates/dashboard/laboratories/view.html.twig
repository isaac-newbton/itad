{% extends "dashboard/dashboard.html.twig" %}

{% block content %}
	<div class="dashboard_content">
		<header>
			<h1>{{ laboratory.name }}</h1>
		</header>
		<div class="laboratory_details dashboard_content_main_box">
			<p><a href="{{ path('laboratories') }}">Back to list</a></p>
			<div class="delete_actions">
				<a href="{{ path('delete_laboratory', {uuid: uuid_encode(laboratory.uuid)}) }}" class="button danger">Delete Laboratory</a>
			</div>
		</div>
	</div>
{% endblock %}