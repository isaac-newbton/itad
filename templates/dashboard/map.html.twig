{% extends "dashboard/dashboard.html.twig" %}

{% block content %}
	<div id="world_map"></div>
	<div id="map_legend">
		<h2>Legend</h2>
		<table>
			<tbody>
				<tr>
					<td>
						<div class="color_block" style="background:#6f9541;"></div>
					</td>
					<td>
						<div class="color_key">Data received</div>
					</td>
				</tr>
				<tr>
					<td>
						<div class="color_block" style="background:#014822;"></div>
					</td>
					<td>
						<div class="color_key">No data received</div>
					</td>
				</tr>
			</tbody>
		</table>
	</div>
	<div id="map_tooltips">
		{% if countryData is not empty %}
			{% for data in countryData %}
				<div class="map_tooltip" data-code="{{ data.code }}" data-country="{{ data.name }}">
					<header>
						<h3>{{ data.name }} ({{ data.code }})</h3>
					</header>
					<div class="content">
						{% if 0 < data.reports|length %}
							{% if data.reports[0].reportLineItems is not empty %}
								{% set renderedItems = 0 %}
								{% set extraItems = 0 %}
								<div>
									{% for item in data.reports[0].reportLineItems %}
										{% if 3 > renderedItems %}
											<div class="adulterant_data">
												<div class="adulterant">
													{{ item.adulterant.name }}
												</div>
												<div class="value">
													{{ item.value }}%
												</div>
											</div>
										{% else %}
											{% set extraItems = extraItems + 1 %}
										{% endif %}
										{% set renderedItems = renderedItems + 1 %}
									{% endfor %}
								</div>
								{% if 0 < extraItems %}
									<div class="extra">
										...and {{ extraItems }} more
									</div>
								{% endif %}
							{% else %}
								The latest report for {{ data.name }} ({{ data.reports[0].year }}) contains no adulterant data.
							{% endif %}
						{% else %}
							There are currently no reports for {{ data.name }}.
						{% endif %}
					</div>
					<footer>
						<a href="{{ data.profileUrl }}" title="{{ data.name }} Profile">Go to profile</a>
					</footer>
				</div>
			{% endfor %}
		{% endif %}
	</div>
{% endblock %}

{% block javascripts %}
	<script src="https://www.gstatic.com/charts/loader.js"></script>
	<script>
		google.charts.load('current', {
			'packages':['geochart'],
			'mapsApiKey':'{{ googleApiKey }}'
		});
		google.charts.setOnLoadCallback(drawRegionsMap);
		function drawRegionsMap() {
			var data = google.visualization.arrayToDataTable([]);

			{% if countryData is not empty %}
				data = google.visualization.arrayToDataTable([
					['Country','Reports'],
					{% for data in countryData %}
						{% if (data.reports is not empty) and (0 < data.reports[0].reportLineItems|length) %}
							['{{ data.name }}', {{ data.reports|length }}],
						{% else %}
							['{{ data.name }}', 0],
						{% endif %}
					{% endfor %}
				])
			{% endif %}

			var options = {
				backgroundColor:{
					fill: 'F5F9FC'
				},
				geochartVersion: 11,
				datalessRegionColor: '#cccccc',
				defaultColor: '#e3e3e3',
				colorAxis: {
					minValue: 0,
					maxValue: 1,
					colors: ['#014822','#6F9541']
				},
				legend: 'none',
				tooltip: {
					trigger: 'selection',
					textStyle: {
						fontName: 'Montserrat'
					}
				}
			};

			var chart = new google.visualization.GeoChart(document.getElementById('world_map'));

			chart.draw(data, options);

			google.visualization.events.addListener(chart, 'select', selectHandler)

			function selectHandler(e){
				let rawSelection = chart.getSelection()
				if(0==rawSelection.length){
					//deselect
				}else{
					let countryName = data.getFormattedValue(rawSelection[0].row, rawSelection[0].column ?? 0)
					let tooltip = $(`.map_tooltip[data-country="${countryName}"]`)
					console.log(tooltip)
				}
			}
		}
	</script>

	{{ parent() }}
{% endblock %}