{% extends "dashboard/dashboard.html.twig" %}

{% block content %}
	<div id="world_map"></div>
{% endblock %}

{% block javascripts %}
	<script src="https://www.gstatic.com/charts/loader.js"></script>
	<script>
		google.charts.load('current', {
			'packages':['geochart'],
			'mapsApiKey':'{{ googleApiKey }}'
		});
		google.charts.setOnLoadCallback(drawRegionsMap);
		function drawRegionsMap() {
			var data = google.visualization.arrayToDataTable([
				['Country', 'Reports', 'Chemicals'],
				['Germany', 200, 225],
				['United States', 300, 100],
				['Brazil', 400, 65],
				['Canada', 500, 40],
				['France', 600, 1200],
				['RU', 700, 1300]
			]);

			{% if countries is not empty %}
				data = google.visualization.arrayToDataTable([
					['Country','Reports'],
					{% for country in countries %}
					['{{ country.name }}', {{ country.yearlyReports|length }}],
					{% endfor %}
				])
			{% endif %}

			var options = {
				backgroundColor:{
					fill: 'F5F9FC'
				},
				geochartVersion: 11,
				datalessRegionColor: '#cccccc',
				defaultColor: '#e3e3e3',
				colorAxis: {
					minValue: 0,
					maxValue: 1,
					colors: ['#014822','#6F9541']
				},
				legend: 'none',
				tooltip: {
					trigger: 'selection',
					textStyle: {
						fontName: 'Montserrat'
					}
				}
			};

			var chart = new google.visualization.GeoChart(document.getElementById('world_map'));

			chart.draw(data, options);
		}
	</script>

	{{ parent() }}
{% endblock %}