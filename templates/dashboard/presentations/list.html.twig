{% extends "dashboard/dashboard.html.twig" %}

{% block content %}
	<div class="dashboard_content">
		<header>
			<h1>Presentations</h1>
		</header>
		<div class="presentations_list">
			{% if presentations is not empty %}
				{% for presentation in presentations %}
					<div class="presentation_container">
						<article>
							<header>
								<span class="meta">{{ presentation.dt|date('m/d/Y') }}</span>
								<h2>{{ presentation.name }}</h2>
							</header>
							<div class="excerpt">
								<em>{{ presentation.author }}</em>
							</div>
							{% if is_granted('ROLE_ADMIN') %}
								<div class="read_more_container">
									<a href="{{ path('edit_presentation', {uuid:uuid_encode(presentation.uuid)}) }}" class="button">Edit</a></p>
								</div>
							{% endif %}
						</article>
					</div>
				{% endfor %}
			{% else %}
				<p>No presentations are posted yet.</p>
			{% endif %}
			{% if is_granted('ROLE_ADMIN') %}
				<p><a href="{{ path('add_presentation') }}" class="button">Add Presentation</a></p>
			{% endif %}
		</div>
	</div>
{% endblock %}