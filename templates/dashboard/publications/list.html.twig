{% extends "dashboard/dashboard.html.twig" %}

{% block content %}
	<div class="dashboard_content">
		<header>
			<h1>Publications</h1>
		</header>
		<div class="publications_list">
			{% if publications is not empty %}
				<div class="pagination_container">
					{{ knp_pagination_render(publications) }}
				</div>
				{% for publication in publications %}
					<div class="publication_container">
						<article>
							<header>
								<h2>{{ publication.name }}</h2>
							</header>
							<div class="excerpt">
								<p><em>{{ publication.author }}</em></p>
								{% if publication.description is not empty %}
									{{ publication.description|raw }}
								{% endif %}
							</div>
							<div class="read_more_container">
								{% if publication.url is not empty %}
									<a href="{{ publication.url }}" class="button" target="_blank">Read More</a>
								{% endif %}
								{% if publication.file %}
									<a href="{{ publication.fileHref }}" class="button" download>Download</a>
								{% endif %}
							</div>
							{% if is_granted('ROLE_ADMIN') %}
								<div class="read_more_container">
									<a href="{{ path('edit_publication', {uuid:uuid_encode(publication.uuid)}) }}" class="button">Edit</a></p>
								</div>
							{% endif %}
						</article>
					</div>
				{% endfor %}
				<div class="pagination_container">
					{{ knp_pagination_render(publications) }}
				</div>
			{% else %}
				<p>No publications are posted yet.</p>
			{% endif %}
			{% if is_granted('ROLE_ADMIN') %}
				<p><a href="{{ path('add_publication') }}" class="button">Add Publication</a></p>
			{% endif %}
		</div>
	</div>
{% endblock %}