{% extends "dashboard/dashboard.html.twig" %}

{% block content %}
	<div class="dashboard_content">
		<header>
			<h1>Participating Laboratories for {{ report.country.code }}-{{ report.year }}</h1>
		</header>
		<div class="add_edit_form">
			<p>Set the Participating Laboratories for the {{ report.year }} report in {{ report.country.name }}.</p>
			{{ form(form) }}
		</div>
	</div>
{% endblock %}