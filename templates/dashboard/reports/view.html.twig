{% extends "dashboard/dashboard.html.twig" %}

{% block content %}
	<div class="dashboard_content">
		<header class="country_header">
			{% if country.flagImgSrc %}
				<img src="{{ country.flagImgSrc }}" alt="{{ country.name }}">
			{% endif %}
			<h1>
				{{ country.name }}
				<span class="report_last_submission">Last Submission: {{ 'now'|date('m/d/Y') }}</span>
			</h1>
		</header>
		
		{% if is_granted('ROLE_ADMIN') %}
			<div>
				<a href="{{ path('edit_country', {code:country.code}) }}">Edit country</a>
				<a href="{{ path('add_flag', {code: country.code}) }}">Set Flag</a>
			</div>
		{% endif %}

		<div class="report_tabs_container">
			{% if reports is not empty %}
				{% for r in reports %}
					<div class="tab{{ r.year == report.year ? ' active' : '' }}">
						{% if r.year == report.year %}
							{{ r.year }}
						{% else %}
							<a href="{{ path('report', {code:country.code, year:r.year}) }}">{{ r.year }}</a>
						{% endif %}
					</div>
				{% endfor %}
			{% endif %}
			{% if is_granted('ROLE_ADMIN') %}
				<div class="tab add">
					<a href="{{ path('add_report', {code:country.code}) }}">+Add</a>
				</div>
			{% endif %}
		</div>
		<div class="report_details">
			{% if is_granted('ROLE_ADMIN') %}
				<a href="{{ path('edit_report', {uuid:uuid_encode(report.uuid)}) }}" class="button">Edit Report</a>
			{% endif %}
			<div class="laboratories">
				<h2>Participating Laboratories</h2>
				{% if report.participatingLaboratories is not empty %}
					<ul>
						{% for laboratory in report.participatingLaboratories %}
							<li>{{ laboratory.name }}</li>
						{% endfor %}
					</ul>
				{% else %}
					<p>No data yet</p>
				{% endif %}
				{% if is_granted('ROLE_ADMIN') %}
					<a href="{{ path('add_laboratory_to_report', {uuid:uuid_encode(report.uuid)}) }}" class="button">Edit Laboratories</a>
				{% endif %}
			</div>
			{% if report.description %}
				<div class="description">
					<h2>Description</h2>
					{{ report.description|raw }}
				</div>
			{% endif %}
			<div class="adulterants">
				<h2>Total Adulterants by Year</h2>
				{% if report.reportLineItems is not empty %}
					<ul>
						{% for item in report.reportLineItems %}
							<li>
								<div class="adulterant">
									{{ item.adulterant.name }}
								</div>
								<div class="percentage">
									{{ item.value }}%
								</div>
								{% if is_granted('ROLE_ADMIN') %}
									<div class="delete_actions">
										<a href="#" class="button danger">Delete</a>
									</div>
								{% endif %}
							</li>
						{% endfor %}
					</ul>
				{% else %}
					<p>No data yet</p>
				{% endif %}
				{% if is_granted('ROLE_ADMIN') %}
					<a href="{{ path('add_adulterant_to_report', {uuid:uuid_encode(report.uuid)}) }}" class="button">Add an Adulterant</a>
				{% endif %}
			</div>
			<div class="downloads">
				{% if report.fileDownloads is not empty %}
					<h2>Downloads</h2>
					<div class="downloads_list_container">
						{% for download in report.fileDownloads %}
							<div class="download" href="{{ download.href }}" target="_blank" download>
								<div class="thumbnail_container">
									{% if download.thumbnail %}
										<a href="{{ download.thumbnailImgSrc }}" target="_blank">
											<img src="{{ download.thumbnailImgSrc }}" alt="{{ download.file.name }}" class="thumbnail">
										</a>
									{% endif %}
								</div>
								<div class="details_container">
									{{ download.file.name }}
									<a class="cta" href="{{ download.href }}" target="_blank" download>
										Download PDF
									</a>
								</div>
							</div>
						{% endfor %}
					</div>
				{% endif %}
				{% if is_granted('ROLE_ADMIN') %}
					<p>
						<a href="{{ path('add_download_to_report', {uuid:uuid_encode(report.uuid)}) }}" class="button">Add a Download</a>
					</p>
				{% endif %}
			</div>
			{% if is_granted('ROLE_ADMIN') %}
				<div class="delete_actions">
					<a href="{{ path('delete_report', {uuid:uuid_encode(report.uuid)}) }}" class="button danger">Delete Report</a>
				</div>
			{% endif %}
		</div>
	</div>
{% endblock %}