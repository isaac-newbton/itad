{% extends "dashboard/dashboard.html.twig" %}

{% block content %}
	<div class="dashboard_content">
		<header>
			<h1>Users</h1>
		</header>
		<div class="user_list_container dashboard_content_main_box">
			<a href="{{ path('add_user') }}" class="button">Add User</a>
			<table class="list_table">
				<tbody>
					{% for user in users %}
						<tr>
							<td>
								{{ user.email }}
							</td>
							<td>
								{{ user.roles[0] }}
							</td>
							<td>
								<a href="{{ path('edit_user', {id:user.id, field:'email'}) }}">Edit Email</a>
								<a href="{{ path('edit_user', {id:user.id, field:'password'}) }}">Edit Password</a>
								{% if 'ROLE_DEVELOPER' != user.roles[0] %}
									<a href="{{ path('edit_user', {id:user.id, field:'role'}) }}">Edit Role</a>
								{% endif %}
								{% if app.user.id != user.id %}
									<a href="{{ path('delete_user', {id:user.id}) }}" class="button danger" onclick="return confirm('Deleting this user will remove their ability to log in')">Delete User</a>
								{% endif %}
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}