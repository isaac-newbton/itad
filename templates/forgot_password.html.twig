{% extends "base.html.twig" %}

{% block body %}
	<div class="login_form_wrapper">
		<header>
			<h1>Forgot password</h1>
		</header>
		{% if email %}
			<p>An email with a new password was sent to <strong>{{ email }}</strong>, if a matching user account exists.</p>
		{% else %}
			<p>Enter your email to have a temporary password sent to you.</p>
			<form method="post" class="login_form">
				<div class="form_row">
					<label for="email">Email</label>
					<input type="email" name="email" id="email" value="" required autofocus>
				</div>
				<div class="form_row">
					<button type="submit">Submit</button>
				</div>
			</form>
		{% endif %}
		<p><a href="{{ path('login') }}">Return to login</a></p>
	</div>
{% endblock %}