{% extends "base.html.twig" %}

{% block body %}
	<div class="login_form_wrapper">
		<header>
			<div class="login_main_image">
				<img src="images/colombo.jpg" alt="Colombo Plan Logo">
				<img src="images/jmj-logo.jpg" alt="JMJ Technologies Medical Research and Development Logo">
				<img src="images/rieders-logo.jpg" alt="Fredric Rieders Family Foundation Logo">
			</div>
		</header>
		<form method="post" class="login_form">
			{% if error %}
				<div class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
			{% endif %}
			<div class="form_row">
				<label for="username">Email</label>
				<input type="email" name="email" id="username" value="{{ last_username }}" required autofocus>
			</div>
			<div class="form_row">
				<label for="paswword">Password</label>
				<input type="password" name="password" id="password" required>
			</div>
			<div class="form_row">
				<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
				<button type="submit">Login</button>
			</div>
		</form>
		<div>
			<a href="{{ path('reset_password') }}">Forgot password</a>
		</div>
	</div>
{% endblock %}